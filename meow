        int e = eggs % 12;
        double bill = 0.0;

        if (d < 4) {
            bill = (d * 0.50) + (e * (0.50 / 12));
        } else {
            if (d < 6) {
                bill = (d * 0.45) + (e * (0.45 / 12));
            } else {
                if (d < 11) {
                    bill = (d * 0.40) + (e * (0.40 / 12));
                } else {
                    bill = (d * 0.35) + (e * (0.35 / 12));
                }
            }
        }

        System.out.printf("The bill is equal to: $%.2f%n", bill);
        System.out.println();
    }
