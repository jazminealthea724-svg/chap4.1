import java.util.Scanner;
public class Main {
    static Scanner input = new Scanner(System.in);

    static void primenum1() {
        System.out.print("Enter an integer num: ");
        int num = input.nextInt();

        boolean prime = true;

        for (int i = 2; i < num; i++) {
            if (num % i == 0) {
                prime = false;
            }
        }

        if (prime) {
            System.out.println(num + " is a prime number.");
        } else {
            System.out.println(num + " is not a prime number.");
        }
        System.out.println();
    }

    static void primefac2() {
        System.out.print("Enter an integers: ");
        int num = input.nextInt();
        int counter = 2;

        while (counter <= num) {
            if (num % counter == 0) {
                System.out.println(counter);
                num = num / counter;
            } else {
                counter++;
                System.out.println();
            }
        }
    }
    static void investment3() {

        double investment = 2500.00;
        double target = 5000.00;
        double rate = 0.075;
        int year = 0;

        while (investment < target) {
            investment = investment + (investment * rate);
            year++;
        }
                System.out.println("it will take" + year +"years for the investment to be worth at least 5000.");
                System.out.println("Final Investment Value:" + investment);
                System.out.println();
            }
        static void carRecall4() {
            System.out.print("Enter the cars model num or 0 to quit: ");
