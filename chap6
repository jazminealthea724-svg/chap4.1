        static void gcd10() {
            System.out.print("Enter a num: ");
            int number1 = input.nextInt();
            System.out.print("Enter a second num: ");
            int number2 = input.nextInt();

            while (number2 > 0) {
                int temp = number1 % number2;
                number1 = number2;
                number2 = temp;
            }
            System.out.println("The GCD is: " + number1);
        }
