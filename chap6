            }
        }
        static void digitsdisplay5() {
            System.out.print("Enter a positive integers: ");
            int i = input.nextInt();
            int t = i;
            int d =1;

            while ( t >= 10) {
                d = d * 10;
                t = t / 10;
            }
            while (d > 0) {
                int digit = i / d;
                System.out.println(digit);

                i = i % d;
                d = d / 10;
                System.out.println();
            }
        }
        static void digitsum6() {
            System.out.print("Enter a positive integers: ");
            int num = input.nextInt();
            int sum = 0;

            while (num > 0) {
                int d = num % 10;
                sum = sum + d;
                num = num / 10;
            }
            System.out.println("The sum of the digits is: " + sum);
            System.out.println();
        }
        static void cubesum7(){
            System.out.println("Enter a positive integers:");
            int n = input.nextInt();
            int s = 0;

            while (n > 0) {
                int digit = n % 10;
                s = s + (digit * digit * digit);
                n = n / 10;
            }
                System.out.println("The sum of the cubes is: " + s);
                System.out.println();
        }
        static void guessingG8(){
            int secretnum = 19;
            int guess = 0;

            while (guess != secretnum) {
